{
  "name": "expense-tracker-api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types ./src/types/worker-configuration.d.ts --env-interface CloudflareBindings",
    "prepare": "husky",
    "lint": "eslint",
    "format": "prettier --write"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.91",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@braintrust/openai-agents": "^0.1.5",
    "@google/genai": "^2.10.0",
    "@hono/zod-validator": "^0.9.0",
    "@openai/agents": "^0.13.2",
    "@openai/agents-extensions": "^0.13.5",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.110.8",
    "ai": "^7.0.28",
    "braintrust": "^3.27.0",
    "hono": "^4.12.27",
    "honox": "^0.1.59",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "wrangler": "^4.118.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
