{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chatbot",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/index.js",
  "assets": {
    "directory": "./dist",
  },
  "ratelimits": [
    {
      "name": "AGENT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "GOOGLE_GENERATIVE_AI_MODEL": "gemini-3.1-flash-lite",
    "GOOGLE_GENERATIVE_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "MERCURY_BASE_URL": "https://api.inceptionlabs.ai/v1",
    "MERCURY_MODEL": "mercury-2",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    "EMBEDDING_MODEL": "gemini-embedding-2",
    "TEAM_DOMAIN": "https://leongjw98.cloudflareaccess.com",
  },
}
